<rxui:ReactiveWindow x:TypeArguments="vm:MainWindowViewModel"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rxui="using:Avalonia.ReactiveUI"
                    xmlns:vm="using:LogTail.UI.ViewModels"
                    xmlns:models="using:LogTail.Core.Models"
                    xmlns:views="using:LogTail.UI.Views"
                    xmlns:converters="using:Avalonia.Data.Converters"
                    x:Class="LogTail.UI.Views.MainWindow"
                    x:DataType="vm:MainWindowViewModel"
                    Title="{Binding WindowTitle}"
                    Width="900"
                    Height="600"
                     DragDrop.AllowDrop="True">
  <rxui:ReactiveWindow.Styles>
    <!-- Ensure TabControl content host stretches full width (Avalonia Fluent TabControl uses PART_SelectedContentHost) -->
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost2">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Ensure ListBox items stretch full width -->
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </rxui:ReactiveWindow.Styles>

  <Grid>
    <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="_File">
          <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" />
          <Separator />
          <MenuItem Header="E_xit" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="_Theme">
            <MenuItem Header="System" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeMode.System}" />
            <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeMode.Light}" />
            <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:ThemeMode.Dark}" />
          </MenuItem>
        </MenuItem>
      </Menu>

      <Grid DockPanel.Dock="Bottom" Height="40" ColumnDefinitions="*,Auto" Margin="8,0">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding SelectedTabStatus}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="10"
                     Opacity="0.7"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1"
                      IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                      OnContent="Auto-scroll"
                      OffContent="Auto-scroll"
                      FontSize="11"
                      VerticalAlignment="Center" />
      </Grid>

      <!-- TabControl -->
      <TabControl x:Name="MainTabControl"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding SelectedTab}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
        
        <TabControl.ItemTemplate>
          <DataTemplate>
            <views:TabItemView />
          </DataTemplate>
        </TabControl.ItemTemplate>
        
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Name="TabLogScrollViewer">
                <ItemsControl ItemsSource="{Binding LogEvents}"
                              HorizontalAlignment="Stretch"
                              Name="TabLogItemsControl">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:EnrichedLogEvent">
                      <Grid ColumnDefinitions="Auto,*"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            MinHeight="20"
                            VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LineNumber, StringFormat={}{0}.}"
                                   Width="55"
                                   TextAlignment="Right"
                                   Margin="6,1,10,1"
                                   Opacity="0.5"
                                   FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                   FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Raw.Line}"
                                   Margin="0,1,10,1"
                                   TextWrapping="NoWrap"
                                   FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                   FontSize="12" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
        
      </TabControl>

      <!-- Empty State (when no tabs) -->
      <Panel IsVisible="{Binding !Tabs.Count}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
        <StackPanel Spacing="8">
          <TextBlock Text="Drop a log file here" 
                     HorizontalAlignment="Center"
                     FontSize="16" />
          <TextBlock Text="or use File > Open"
                     HorizontalAlignment="Center"
                     Opacity="0.6" />
        </StackPanel>
      </Panel>

    </DockPanel>

    <!-- Global Loading Indicator Overlay (Centered in Window) -->
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            Opacity="0.85"
            IsVisible="{Binding SelectedTab.IsLoading, FallbackValue=False}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  MaxWidth="500">
        <ProgressBar IsIndeterminate="True"
                     Width="240"
                     Height="4"
                     HorizontalAlignment="Center" />
        <StackPanel HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="Loading log file..."
                     FontSize="14"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding SelectedTab.FilePath}"
                     FontSize="11"
                     Opacity="0.6"
                     MaxWidth="450"
                     TextAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</rxui:ReactiveWindow>